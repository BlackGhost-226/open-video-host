{
    "intructions": [
        {"s3.download": {"kwargs": {}, "args": ["/video"], "write_to": "vid"}},

        {"ffmpeg.compress_file": {"kwargs": {}, "args": ["V:{vid}", "video"], "write_to": null}},
        {"ffmpeg.get_jpg": {"kwargs": {}, "args": ["V:{img}"], "write_to": "img"}},
        {"ffmpeg.set_scale": {"kwargs": {}, "args": ["V:{img}", "thumbnail"], "write_to": null}},
        {"ffmpeg.convert_to_hls": {"kwargs": {}, "args": ["V:{vid}"], "write_to": "hls"}},
        {"ffmpeg.convert_to_dash": {"kwargs": {}, "args": ["V:{vid}"], "write_to": "dash"}},

        {"sql.new": {"kwargs": {}, "args": [
            "videos", 
            {
                "title": "V:{title}", 
                "description": "V:{description}", 
                "author_user_id": "V:{author_id}"
            }
            ], "write_to": "video"}},

        {"s3.upload": {"kwargs": {}, "args": ["V:{hls}", "streams", "V:{video.id}/hls", "application/x-mpegURL"], "write_to": null}},
        {"s3.upload": {"kwargs": {}, "args": ["V:{dash}", "streams", "V:{video.id}/dash", "application/dash+xml"], "write_to": null}},
        {"s3.upload": {"kwargs": {}, "args": ["V:{img}", "streams", "V:{video.id}/thumbnail.jpg", "image/jpeg"], "write_to": null}}
    ]
}