{
    "intructions": [
        {"s3.download": {"kwargs": {"minioPath": "/profile"}, "write_to": "img"}},

        {"ffmpeg.compress_file": {"kwargs": {"input_path": "V:{img}", "type": "image"}}},
        {"ffmpeg.change_format": {"kwargs": {"input_path": "V:{img}", "type": "jpg"}}},
        {"ffmpeg.set_scale": {"kwargs": {"input_path": "V:{img}", "type": "profile"}}},

        {"s3.upload": {"kwargs": {"file_path": "V:{img}", "bucket": "profiles", "minioPath": "V:{user_id}.jpg", "contentType": "image/jpeg"}}}
    ]
}