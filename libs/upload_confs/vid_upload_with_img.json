{
    "intructions": [
        {"s3.download": {"kwargs": {"minioPath": "/video"}, "write_to": "vid"}},
        {"s3.download": {"kwargs": {"minioPath": "/thumbnail"}, "write_to": "img"}},

        {"ffmpeg.compress_file": {"kwargs": {"input_path": "V:{vid}", "type": "video"}}},
        {"ffmpeg.compress_file": {"kwargs": {"input_path": "V:{img}", "type": "image"}}},
        {"ffmpeg.change_format": {"kwargs": {"input_path": "V:{img}", "type": "jpg"}}},
        {"ffmpeg.set_scale": {"kwargs": {"input_path": "V:{img}", "type": "thumbnail"}}},
        {"ffmpeg.convert_to_hls": {"kwargs": {"input_path": "V:{vid}"}, "write_to": "hls"}},
        {"ffmpeg.convert_to_dash": {"kwargs": {"input_path": "V:{vid}"}, "write_to": "dash"}},

        {"sql.add": {"kwargs": 
        {
            "table": "videos", 

            "title": "V:{title}", 
            "description": "V:{description}", 
            "author_user_id": "V:{author_id}"
            }, "write_to": "video"}},

        {"s3.upload": {"kwargs": {"file_path": "V:{hls}", "bucket": "streams", "minioPath": "V:{video.id}/hls", "contentType": "application/x-mpegURL"}}},
        {"s3.upload": {"kwargs": {"file_path": "V:{dash}", "bucket": "streams", "minioPath": "V:{video.id}/dash", "contentType": "application/dash+xml"}}},
        {"s3.upload": {"kwargs": {"file_path": "V:{img}", "bucket": "streams", "minioPath": "V:{video.id}/thumbnail.jpg", "contentType": "image/jpeg"}}}
    ]
}